{
  "name": "vscode-remote-snippets",
  "displayName": "Remote Snippets",
  "description": "Auto fetch snippets from remote and load it.",
  "version": "0.4.7",
  "license": "MIT",
  "author": {
    "name": "Jerry wang",
    "email": "x.jerry.wang@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/0x-jerry/vscode-remote-snippets/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0x-jerry/vscode-remote-snippets.git"
  },
  "publisher": "fantasy",
  "packageManager": "bun@1.4.3",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "remote",
    "snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/logo.png",
  "main": "./dist/extension.js",
  "type": "module",
  "contributes": {
    "configuration": {
      "title": "Remote Snippets",
      "properties": {
        "remote-snippets.snippets": {
          "type": "array",
          "description": "Remote snippets.",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Remote snippet url."
              },
              "language": {
                "type": "string",
                "description": "Specify the language that the snippet applied to."
              }
            }
          }
        },
        "remote-snippets.config": {
          "type": "array",
          "description": "Remote snippets configuration.",
          "items": {
            "type": "string"
          }
        },
        "remote-snippets.js": {
          "type": "array",
          "description": "Those local js file will be loaded dynamically.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commands": [
      {
        "command": "remote-snippets.refresh",
        "category": "Remote Snippets",
        "title": "Update snippets"
      }
    ],
    "keybindings": [],
    "viewsContainers": {},
    "views": {},
    "menus": {},
    "grammars": [],
    "snippets": []
  },
  "scripts": {
    "vscode:prepublish": "tsdown",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "publish": "vsce publish --no-dependencies",
    "release": "x-release"
  },
  "devDependencies": {
    "@0x-jerry/utils": "^6.6.0",
    "@0x-jerry/x-release": "^3.0.5",
    "@types/debounce": "^1.2.4",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "debounce": "^3.0.0",
    "debug": "^4.4.3",
    "fs-extra": "^11.4.1",
    "https-proxy-agent": "^9.1.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.73.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}