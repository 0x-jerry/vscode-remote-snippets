{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsdown",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^error|warning|info",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".+ Build start .+",
          "endsPattern": ".+(Build complete in|Rebuilt in) .+"
        }
      },
      "label": "bun: dev",
      "detail": "tsdown --watch"
    }
  ]
}
